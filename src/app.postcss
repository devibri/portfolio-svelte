@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

/* Typography: override the crimson preset's fonts */
body[data-theme='crimson'] {
	--theme-font-family-base: 'Inter', ui-sans-serif, system-ui, sans-serif;
	--theme-font-family-heading: 'Space Grotesk', 'Inter', ui-sans-serif, system-ui, sans-serif;
}

html {
	scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}
}

strong {
	@apply text-primary-600 dark:text-primary-400;
}

/* Layout */
.page-container {
	@apply mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8;
}

/* Widen on the largest screens; case study prose keeps its reading width */
.page-container:not(.projectpage) {
	@apply 2xl:max-w-[90rem] 2xl:px-12;
}

.section-title {
	@apply mb-8 flex items-center gap-3 font-bold;
}

.section-title::before {
	content: '';
	@apply inline-block h-7 w-1.5 rounded-full bg-primary-500;
}

.section-divider {
	width: min(90%, 1100px);
	height: 1px;
	background: linear-gradient(to right, transparent, rgba(148, 163, 184, 0.8), transparent);
	margin-top: 3rem;
	margin-left: auto;
	margin-right: auto;
}

.muted {
	@apply text-surface-600 dark:text-surface-300;
}

/* Buttons */
.btn.variant-filled-primary,
.btn.variant-filled-primary:hover,
.btn.variant-filled-primary:focus-visible,
.btn.variant-filled-primary:active,
.btn-icon.variant-filled,
.btn-icon.variant-filled:hover,
.btn-icon.variant-filled:focus-visible,
.btn-icon.variant-filled:active {
	background-color: rgb(var(--color-primary-500));
	border-color: rgb(var(--color-primary-500));
	color: white;
}

/* Project cards */
.tool-chip {
	@apply inline-flex items-center rounded-full border border-secondary-500/40 bg-secondary-500/10 px-2.5 py-0.5 text-xs font-semibold tracking-wide text-secondary-700 dark:text-secondary-300;
}

.header-social-link {
	@apply inline-flex items-center justify-center text-xl leading-none transition-colors hover:text-primary-500;
}

/* Case study pages */
.projectpage h2 {
	@apply mt-12 mb-4;
}

.projectpage h3 {
	@apply mt-8 mb-3;
}

.projectpage p {
	@apply my-4 leading-relaxed;
}

.projectpage ul {
	@apply my-4 space-y-2;
}

.projectpage figure {
	@apply mx-auto my-8 w-full md:w-4/5;
}

.projectpage figure img {
	@apply mx-auto block rounded-xl shadow-lg;
}

.projectpage figcaption {
	@apply mt-2 text-center text-sm italic text-surface-600 dark:text-surface-300;
}

.projectpage iframe {
	@apply mx-auto my-8 block aspect-video w-full rounded-xl md:w-4/5;
}
